:grid;grid-template-columns:1fr 1fr;gap:8px}.quick button{border:1px solid var(--line);background:#fbfcfa;border-radius:9px;padding:14px 7px;display:flex;flex-direction:column;align-items:center;gap:5px}.quick span{font-size:9px;color:#69756b}.today{display:flex;flex-direction:column}.today span{display:grid;grid-template-columns:14px 25px 1fr;border-top:1px solid #edf0ed;padding:11px 0;font-size:9px;color:#748077}.today i{width:7px;height:7px;border-radius:50%;margin-top:3px}.today .purple{background:#9e7bc8}.today .amber{background:#e0ad43}.today .green{background:#68a76f}.toolbar label{height:39px;width:400px;background:#fff;border:1px solid var(--line);border-radius:9px;display:flex;align-items:center;padding:0 11px;color:#8e9990}.toolbar input{border:0;outline:0;background:none;width:100%;padding-left:8px;font-size:10px}.table{background:#fff;border:1px solid var(--line);border-radius:13px;overflow:hidden}.table table{width:100%;border-collapse:collapse}.table th{text-align:left;padding:11px 14px;background:#fafbf9;font-size:8px;letter-spacing:.08em;text-transform:uppercase;color:#929c94}.table td{padding:12px 14px;border-top:1px solid #edf0ec;font-size:10px}.table td>b,.table td>small{display:block}.table td small{color:#929b94;margin-top:3px}.person{display:flex;align-items:center;gap:9px}.person>i{width:31px;height:31px;background:#edf3e9;border-radius:8px;display:grid;place-items:center;color:#607b4e;font-size:8px;font-style:normal;font-weight:800}.person span{display:flex;flex-direction:column}.click{cursor:pointer}.click:hover{background:#fbfcfa}.machinegrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.machine{background:#fff;border:1px solid var(--line);border-radius:13px;overflow:hidden}.machinePic{height:142px;background:linear-gradient(145deg,#edf3e8,#f8faf7);display:grid;place-items:center;font-size:56px;color:#52674d;position:relative}.machinePic span{position:absolute;bottom:9px;left:10px;background:#fff;border:1px solid var(--line);border-radius:99px;padding:4px 7px;font-size:8px}.machine>div:last-child{padding:16px}.machine>div>small{font-size:8px;letter-spacing:.1em;color:#759061;text-transform:uppercase}.machine h3{margin:3px 0 13px}.machine p{display:flex;justify-content:space-between;border-top:1px solid #edf0ed;padding-top:7px;font-size:9px;color:#707c73}.machine p b{color:#9ba49d;font-weight:500}.back{border:0;background:none;color:#708076;font-size:10px;padding:0;margin-bottom:16px}.jobhead{display:flex;justify-content:space-between;align-items:end;margin-bottom:20px}.jobhead h2{font-size:28px;margin:5px 0 2px}.jobhead p{font-size:10px;color:#7d8980}.jobhead>div:last-child{display:flex;gap:7px}.jobhead select,.jobhead button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px 10px;font-size:10px}.infogrid{display:grid;grid-template-columns:1fr 1fr;gap:17px}.info{display:flex;flex-direction:column;margin-bottom:14px}.info.wide{grid-column:1/-1}.info small{font-size:8px;text-transform:uppercase;letter-spacing:.07em;color:#9aa39c;margin-bottom:4px}.info b{font-size:10px;line-height:1.5}.lines{margin:14px 0 20px}.lines h4{font-size:9px;text-transform:uppercase;color:#7b877d}.lines>div{display:grid;grid-template-columns:1fr 140px 90px;border-top:1px solid #edf0ed;padding:8px 0;font-size:10px}.lines>div span:nth-child(2),.lines>div b{text-align:right}.totals{width:320px;margin-left:auto;border-top:1px solid var(--line)}.totals p{display:flex;justify-content:space-between;font-size:10px}.totals .grand{border-top:1px solid var(--line);padding-top:10px;font-size:12px}.overlay{position:fixed;inset:0;background:rgba(10,20,13,.55);backdrop-filter:blur(3px);z-index:50;display:grid;place-items:center;padding:20px}.modal{width:min(530px,100%);background:#fff;border-radius:17px;padding:24px;box-shadow:0 35px 100px rgba(0,0,0,.28)}.modal>header{display:flex;align-items:start;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:16px}.modal h2{margin:4px 0 0}.modal header button{border:0;background:#f1f4ef;border-radius:8px;width:33px;height:33px}.modal form{display:flex;flex-direction:column;gap:11px}.modal label{font-size:9px;font-weight:700;color:#66736a;display:flex;flex-direction:column;gap:5px}.modal input,.modal select,.modal textarea{border:1px solid #dfe5dc;border-radius:8px;padding:10px;background:#fcfdfb;outline:none;font-size:11px}.modal textarea{min-height:75px}.formrow{display:grid;grid-template-columns:1fr 1fr;gap:10px}.formactions{display:flex;justify-content:flex-end;gap:8px;border-top:1px solid var(--line);padding-top:15px;margin-top:4px}.formactions button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px 12px;font-size:10px}.formactions .primaryBtn{background:var(--green);border:0}
@media(max-width:1050px){.cards{grid-template-columns:1fr 1fr}.hero{gap:35px}.process{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.machinegrid{grid-template-columns:1fr 1fr}.dashgrid,.detailgrid{grid-template-columns:1fr 1fr}.panel.wide{grid-column:span 2}.panel.full{grid-column:1/-1}}
@media(max-width:760px){.pubnav{padding:0 18px;height:auto;min-height:86px;gap:12px}.logoFrame{padding:6px 10px}.logoFrame img{height:52px}.pubnav nav a{display:none}.hero{grid-template-columns:1fr;padding:55px 20px}.heroLogo{height:82px}.heroCard{display:none}.heroCopy h1{font-size:50px}.actions{flex-direction:column}.benefits{grid-template-columns:1fr 1fr;height:auto;padding:18px}.
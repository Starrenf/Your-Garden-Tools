 p{font-size:10px;color:#7d8980}.jobhead>div:last-child{display:flex;gap:7px}.jobhead select,.jobhead button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px 10px;font-size:10px}.infogrid{display:grid;grid-template-columns:1fr 1fr;gap:17px}.info{display:flex;flex-direction:column;margin-bottom:14px}.info.wide{grid-column:1/-1}.info small{font-size:8px;text-transform:uppercase;letter-spacing:.07em;color:#9aa39c;margin-bottom:4px}.info b{font-size:10px;line-height:1.5}.lines{margin:14px 0 20px}.lines h4{font-size:9px;text-transform:uppercase;color:#7b877d}.lines>div{display:grid;grid-template-columns:1fr 140px 90px;border-top:1px solid #edf0ed;padding:8px 0;font-size:10px}.lines>div span:nth-child(2),.lines>div b{text-align:right}.totals{width:320px;margin-left:auto;border-top:1px solid var(--line)}.totals p{display:flex;justify-content:space-between;font-size:10px}.totals .grand{border-top:1px solid var(--line);padding-top:10px;font-size:12px}.overlay{position:fixed;inset:0;background:rgba(10,20,13,.55);backdrop-filter:blur(3px);z-index:50;display:grid;place-items:center;padding:20px}.modal{width:min(530px,100%);background:#fff;border-radius:17px;padding:24px;box-shadow:0 35px 100px rgba(0,0,0,.28)}.modal>header{display:flex;align-items:start;justify-content:space-between;border-bottom:1px solid var(--line);padding-bottom:14px;margin-bottom:16px}.modal h2{margin:4px 0 0}.modal header button{border:0;background:#f1f4ef;border-radius:8px;width:33px;height:33px}.modal form{display:flex;flex-direction:column;gap:11px}.modal label{font-size:9px;font-weight:700;color:#66736a;display:flex;flex-direction:column;gap:5px}.modal input,.modal select,.modal textarea{border:1px solid #dfe5dc;border-radius:8px;padding:10px;background:#fcfdfb;outline:none;font-size:11px}.modal textarea{min-height:75px}.formrow{display:grid;grid-template-columns:1fr 1fr;gap:10px}.formactions{display:flex;justify-content:flex-end;gap:8px;border-top:1px solid var(--line);padding-top:15px;margin-top:4px}.formactions button{border:1px solid var(--line);background:#fff;border-radius:8px;padding:9px 12px;font-size:10px}.formactions .primaryBtn{background:var(--green);border:0}
@media(max-width:1050px){.cards{grid-template-columns:1fr 1fr}.hero{gap:35px}.process{grid-template-columns:1fr}.metrics{grid-template-columns:1fr 1fr}.machinegrid{grid-template-columns:1fr 1fr}.dashgrid,.detailgrid{grid-template-columns:1fr 1fr}.panel.wide{grid-column:span 2}.panel.full{grid-column:1/-1}}
@media(max-width:760px){.pubnav{padding:0 18px;height:auto;min-height:86px;gap:12px}.logoFrame{padding:0}.logoFrame img{width:180px;height:auto}.pubnav nav a{display:none}.hero{grid-template-columns:1fr;padding:55px 20px}.heroLogo{width:100%;height:auto}.heroCard{display:none}.heroCopy h1{font-size:50px}.actions{flex-direction:column}.benefits{grid-template-columns:1fr 1fr;height:auto;padding:18px}.benefits div{padding:12px}.section{padding:70px 20px}.sectionHead{grid-template-columns:1fr;gap:10px}.cards{grid-template-columns:1fr}.process{padding:35px 24px}.steps{grid-template-columns:1fr}.contact{padding:38px 25px;flex-direction:column;align-items:flex-start;gap:25px}.contactInfo{grid-template-columns:1fr;gap:18px}footer{flex-wrap:wrap;gap:14px;padding:20px}.footerBrand img{width:180px;height:auto}.admin{grid-template-columns:68px 1fr}.admin aside{width:68px;padding:17px 7px}.brandBox img{height:38px;padding:4px}.brandBox small,.admin aside nav button span,.admin aside nav button em,.profile span,.siteBack{display:none}.admin aside nav button{justify-content:center}.workspace{grid-column:2}.workspace>header{padding:0 17px}.content{padding:20px 16px}.metrics{grid-template-columns:1fr}.dashgrid,.detailgrid{grid-template-columns:1fr}.panel.wide,.panel.full{grid-column:auto}.machinegrid{grid-template-columns:1fr}.table{overflow:auto}.table table{min-width:680px}.jobhead{align-items:flex-start;flex-direction:column;gap:12px}.jobhead>div:last-child{flex-wrap:wrap}.toolbar label{width:65%}.section h2{font-size:36px}}

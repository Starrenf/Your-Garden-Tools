mmer" v={m?.serial}/><Info l="Klacht / opdracht" v={j.complaint} wide/><Info l="Diagnose" v={j.diagnosis} wide/></div></Panel><Panel title="Planning"><Info l="Aangemaakt" v={fmt(j.created)}/><Info l="Gepland gereed" v={fmt(j.due)}/><Info l="Status" v={j.status}/></Panel><Panel title="Werkzaamheden & onderdelen" cls="full"><Lines title="Arbeid" rows={j.labor}/><Lines title="Onderdelen / materialen" rows={j.parts}/><div className="totals"><p><span>Subtotaal</span><b>{money(sub)}</b></p><p><span>BTW 21%</span><b>{money(vat)}</b></p><p className="grand"><span>Totaal incl. BTW</span><b>{money(total)}</b></p></div></Panel></div></>}
const Info=({l,v,wide})=><div className={'info '+(wide?'wide':'')}><small>{l}</small><b>{v||'—'}</b></div>;
const Lines=({title,rows})=><div className="lines"><h4>{title}</h4>{rows.map((x,i)=><div key={i}><span>{x.description}</span><span>{x.qty} × {money(x.price)}</span><b>{money(x.qty*x.price)}</b></div>)}</div>;
function CustomerModal({data,setData,close}){const[f,setF]=useState({name:'',phone:'',email:'',address:'',city:''});const save=e=>{e.preventDefault();setData(d=>({...d,customers:[...d.customers,{...f,id:'c'+Date.now()}]}));close()};return <Modal title="Nieuwe klant" close={close}><form onSubmit={save}><Field l="Naam" v={f.name} set={v=>setF({...f,name:v})}/><div className="formrow"><Field l="Telefoon" v={f.phone} set={v=>setF({...f,phone:v})}/><Field l="E-mail" v={f.email} set={v=>setF({...f,email:v})}/></div><Field l="Adres" v={f.address} set={v=>setF({...f,address:v})}/><Field l="Plaats" v={f.city} set={v=>setF({...f,city:v})}/><Actions close={close} label="Klant opslaan"/></form></Modal>}
function JobModal({data,setData,close}){const[f,setF]=useState({customerId:data.customers[0]?.id||'',machineId:data.machines[0]?.id||'',title:'',complaint:'',due:new Date(Date.now()+7*864e5).toISOString().slice(0,10)});const machines=data.machines.filter(m=>m.customerId===f.customerId);useEffect(()=>{if(machines[0]&&!machines.some(m=>m.id===f.machineId))setF(x=>({...x,machineId:machines[0].id}))},[f.customerId]);const save=e=>{e.preventDefault();setData(d=>({...d,jobs:[{...f,id:'j'+Date.now(),number:'WO-'+new Date().getFullYear()+'-'+String(d.jobs.length+43).padStart(4,'0'),diagnosis:'',status:'Nieuw',created:new Date().toISOString().slice(0,10),labor:[],parts:[]},...d.jobs]}));close()};return <Modal title="Nieuwe opdracht" close={close}><form onSubmit={save}><label>Klant<select value={f.customerId} onChange={e=>setF({...f,customerId:e.target.value})}>{data.customers.map(c=><option key={c.id} value={c.id}>{c.name}</option>)}</select></label><label>Machine<select value={f.machineId} onChange={e=>setF({...f,machineId:e.target.value})}>{machines.map(m=><option key={m.id} value={m.id}>{m.brand} {m.model}</option>)}</select></label><Field l="Omschrijving" v={f.title} set={v=>setF({...f,title:v})}/><label>Klacht / opdracht<textarea value={f.complaint} onChange={e=>setF({...f,complaint:e.target.value})}/></label><Field l="Gepland gereed" type="date" v={f.due} set={v=>setF({...f,due:v})}/><Actions close={close} label="Opdracht aanmaken"/></form></Modal>}
const Modal=({title,close,children})=><div className="overlay" onMouseDown={e=>e.target===e.currentTarget&&close()}><div className="modal"><header><div><span className="eyebrow">WERKPLAATS</span><h2>{title}</h2></div><button onClick={close}>×</button></header>{children}</div></div>;
const Field=({l,v,set,type='text'})=><label>{l}<input required value={v} type={type} onChange={e=>set(e.target.value)}/></label>;
const Actions=({close,label})=><div className="formactions"><button type="button" onClick={close}>Annuleren</button><button className="primaryBtn">{label}</button></div>;

createRoot(document.getElementById('root')).render(<App/>);

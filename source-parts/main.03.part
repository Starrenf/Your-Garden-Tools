/small></td><td><em className={'badge '+badge(j.status)}>{j.status}</em></td><td>{fmt(j.created)}</td><td>{fmt(j.due)}</td><td>›</td></tr>})}</Table></>}
function Invoices({data}){return <><Toolbar ph="Zoek facturen..."/><Table head={['Factuur','Klant','Datum','Bedrag','Status','']}>{data.invoices.map(i=><tr key={i.id}><td><b>{i.number}</b></td><td>{i.customer}</td><td>{fmt(i.date)}</td><td><b>{money(i.amount)}</b></td><td><em className={'badge '+badge(i.status)}>{i.status}</em></td><td>•••</td></tr>)}</Table></>}

function Radio({selected,playing,volume,error,choose,toggle,setVolume}){
 const station=RADIO_STATIONS.find(s=>s.id===selected)||RADIO_STATIONS[0];
 return <div className="radioPage"><div className="radioIntro"><div><span className="eyebrow">MUZIEK IN DE WERKPLAATS</span><h2>Werkplaatsradio</h2><p>Kies een bekende Nederlandse zender. De radio blijft spelen als je naar een andere werkplaatspagina gaat.</p></div><div className="radioLive"><i className={playing?'pulse on':'pulse'}></i><span>{playing?'Live aan':'Radio uit'}</span></div></div><div className="radioGrid">{RADIO_STATIONS.map(s=><button key={s.id} className={'stationCard '+(s.id===selected?'selected':'')} onClick={()=>choose(s.id)}><span className={'stationLogo '+s.id}>{s.short}</span><span className="stationMeta"><b>{s.name}</b><small>{s.tag}</small></span><span className="stationCheck">{s.id===selected?'✓':'›'}</span></button>)}</div><section className="radioConsole"><div className="nowPlaying"><span className={'stationLogo big '+station.id}>{station.short}</span><div><small>GESELECTEERD</small><h3>{station.name}</h3><p>{station.tag}</p></div></div><button className="playButton" onClick={toggle}>{playing?'❚❚':'▶'}</button><div className="volumeControl"><span>🔊</span><input aria-label="Volume" type="range" min="0" max="1" step="0.05" value={volume} onChange={e=>setVolume(Number(e.target.value))}/><b>{Math.round(volume*100)}%</b></div></section>{error&&<div className="radioError">{error}</div>}<div className="radioNote"><b>Blijft doorspelen</b><span>Je kunt nu gewoon naar klanten, machines, opdrachten of facturen wisselen zonder dat de stream stopt.</span></div></div>
}

function MiniRadio({station,playing,volume,toggle,setVolume,openRadio}){
 return <div className={'miniRadio '+(playing?'isPlaying':'')}><button className="miniStation" onClick={openRadio} title="Open Werkplaatsradio"><span className={'stationLogo mini '+station.id}>{station.short}</span><span><small>{playing?'LIVE · WERKPLAATSRADIO':'WERKPLAATSRADIO'}</small><b>{station.name}</b></span></button><button className="miniPlay" onClick={toggle} aria-label={playing?'Pauzeren':'Afspelen'}>{playing?'❚❚':'▶'}</button><label className="miniVolume"><span>🔊</span><input aria-label="Radio volume" type="range" min="0" max="1" step="0.05" value={volume} onChange={e=>setVolume(Number(e.target.value))}/></label><button className="miniOpen" onClick={openRadio}>Radio <span>↑</span></button></div>
}

const Table=({head,children})=><div className="table"><table><thead><tr>{head.map((h,i)=><th key={i}>{h}</th>)}</tr></thead><tbody>{children}</tbody></table></div>;
function Job({data,setData,id,back}){const j=data.jobs.find(x=>x.id===id)||data.jobs[0];if(!j)return null;const c=data.customers.find(x=>x.id===j.customerId),m=data.machines.find(x=>x.id===j.machineId);const sub=[...j.labor,...j.parts].reduce((a,x)=>a+x.qty*x.price,0),vat=sub*.21,total=sub+vat;const setStatus=s=>setData(d=>({...d,jobs:d.jobs.map(x=>x.id===j.id?{...x,status:s}:x)}));const print=kind=>{const rows=[...j.labor,...j.parts].map(x=>`<tr><td>${x.description}</td><td>${x.qty}</td><td>${money(x.price)}</td><td>${money(x.qty*x.price)}</td></tr>`).join('');const w=window.open('','_blank');w.document.write(`<html><head><title>${kind}</title><style>body{font-family:Arial;padding:45px;color:#222}header{display:flex;justify-content:space-between;border-bottom:2px solid #222;padding-bottom:20px}table{width:100%;border-collapse:collapse;margin-top:30px}th,td{padding:10px;border-bottom:1px solid #ddd;text-align:left}.tot{width:320px;margin:25px 0 0 auto}.tot p{display:flex;justify-content:space-between}</style></head><body><header><div><b>Your Garden Tools</b><br>Ingenopestraat 6, Bunde</div><h1>${kind}</h1></header><p><b>${c.name}</b><br>${c.address}, ${c.city}<br><br>Machine: ${m.brand} ${m.model}<br>Opdracht: ${j.number}</p><table><tr><th>Omschrijving</th><th>Aantal</th><th>Prijs</th><th>Totaal</th></tr>${rows}</table><div class="tot"><p><span>Subtotaal</span><b>${money(sub)}</b></p><p><span>BTW 21%</span><b>${money(vat)}</b></p><p><b>Totaal</b><b>${money(total)}</b></p></div><script>window.print()</script></body></html>`);w.document.close()};return <><button className="back" onClick={back}>← Terug naar opdrachten</button><div className="jobhead"><div><span className="eyebrow">{j.number}</span><h2>{j.title}</h2><p>{c?.name} · {m?.brand} {m?.model}</p></div><div><select value={j.status} onChange={e=>setStatus(e.target.value)}>{['Nieuw','In onderzoek','Wachten op akkoord','In uitvoering','Gereed','Afgehaald'].map(s=><option key={s}>{s}</option>)}</select><button onClick={()=>print('Werkbon')}>Werkbon</button><button className="primaryBtn" onClick={()=>print('Factuur')}>Factuur maken</button></div></div><div className="detailgrid"><Panel title="Opdrachtinformatie" cls="wide"><div className="infogrid"><Info l="Klant" v={c?.name}/><Info l="Telefoon" v={c?.phone}/><Info l="Machine" v={`${m?.brand} ${m?.model}`}/><Info l="Serienu
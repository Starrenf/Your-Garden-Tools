sform:translateX(5px);border-color:rgba(183,223,131,.28)}
.contact{box-shadow:0 22px 60px rgba(85,132,47,.22);background:radial-gradient(circle at 92% 20%,rgba(255,255,255,.18),transparent 23%),linear-gradient(120deg,#64922f,#8fbe4e 58%,#9dce5d)}
.metric,.panel{transition:transform .2s ease,box-shadow .2s ease,border-color .2s ease}.metric:hover,.panel:hover{transform:translateY(-3px);box-shadow:0 18px 42px rgba(22,43,27,.085);border-color:#d5e1cf}
.admin aside{background:radial-gradient(circle at 0 0,rgba(134,184,74,.12),transparent 24%),linear-gradient(180deg,#16251c,#102018)}
.admin aside nav button.active{background:linear-gradient(90deg,rgba(134,184,74,.18),rgba(255,255,255,.06));box-shadow:inset 3px 0 0 var(--green)}
.workspace>header{background:rgba(255,255,255,.9);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);position:sticky;top:0;z-index:12}
.stationCard.selected{box-shadow:0 16px 38px rgba(92,139,51,.16)}.playButton,.miniPlay{transition:transform .18s ease,box-shadow .18s ease}.playButton:hover,.miniPlay:hover{transform:scale(1.06);box-shadow:0 12px 30px rgba(134,184,74,.3)}
.miniRadio{background:linear-gradient(105deg,rgba(19,34,25,.97),rgba(29,54,37,.96));box-shadow:0 24px 70px rgba(10,27,16,.31)}

@keyframes fadeUp{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:translateY(0)}}
@keyframes heroFloat{0%,100%{transform:rotate(1.2deg) translateY(0)}50%{transform:rotate(.5deg) translateY(-8px)}}
@keyframes floatBadge{0%,100%{transform:rotate(-2deg) translateY(0)}50%{transform:rotate(-1deg) translateY(-5px)}}
@media (prefers-reduced-motion:reduce){*,*::before,*::after{scroll-behavior:auto!important;animation:none!important;transition:none!important}}

/* Landscape tablet / compact laptop */
@media(max-width:1100px){
 .pubnav{padding:0 3vw}.logoFrame img{width:220px}.pubnav nav{gap:20px}
 .hero{padding:64px 5vw;gap:32px}.heroCopy h1{font-size:clamp(44px,5vw,62px)}
 .section{padding-left:28px;padding-right:28px}.sectionHead{grid-template-columns:1fr 360px;gap:36px}
 .admin{grid-template-columns:210px 1fr}.admin aside{width:210px}.miniRadio{left:230px}
 .content{padding-left:26px;padding-right:26px}.workspace>header{padding-left:26px;padding-right:26px}
}

/* Tablet portrait: explicitly optimized instead of desktop squeezed smaller */
@media(max-width:900px){
 .pubnav{min-height:88px;height:auto;padding:10px 24px}.logoFrame img{width:min(220px,42vw)}.pubnav nav a{display:none}.pubnav nav{gap:10px}.pubnav nav button{min-height:44px;padding:12px 18px}
 .hero{grid-template-columns:1fr;min-height:auto;padding:54px 7vw 64px;gap:36px}.hero::before{width:310px;height:310px;right:-130px;top:180px}.heroCopy{max-width:720px}.heroLogoFrame{width:min(100%,520px)}.heroCopy h1{font-size:clamp(48px,8vw,68px);max-width:760px}.heroCopy>p{max-width:680px}.heroCard{width:min(100%,680px);justify-self:center;transform:none!important;animation:none}.brandShowcase{min-height:340px}.float{left:18px;bottom:88px}
 .benefits{grid-template-columns:1fr 1fr;height:auto;padding:18px 5vw}.benefits div{min-height:52px}
 .section{padding:78px 5vw}.sectionHead{grid-template-columns:1fr;gap:8px}.sectionHead p{max-width:680px}.cards{grid-template-columns:1fr 1fr}.process{padding:45px 34px}.contact{padding:46px 38px}.contactInfo{grid-template-columns:1.4fr 1fr 1.4fr;gap:18px}
 .admin{grid-template-columns:82px 1fr}.admin aside{width:82px;padding:16px 9px}.brandBox{padding:0 4px 16px}.brandBox img{height:52px;padding:5px}.brandBox small,.admin aside nav button span,.admin aside nav button em,.profile span,.siteBack{display:none}.admin aside nav button{justify-content:center;min-height:46px;font-size:16px}.profile{justify-content:center;padding-left:0;padding-right:0}
 .workspace{grid-column:2}.workspace>header{height:78px;padding:0 20px}.workspace>header h1{font-size:20px}.content{padding:22px 20px 48px}.metrics{grid-template-columns:1fr 1fr}.dashgrid,.detailgrid{grid-template-columns:1fr 1fr}.machinegrid{grid-template-columns:1fr 1fr}.toolbar{gap:12px;align-items:stretch}.toolbar label{min-width:0;flex:1}.toolbar input,.toolbar select,.jobhead select,.modal input,.modal select,.modal textarea{min-height:44px}.toolbar button,.jobhead button,.formactions button{min-height:44px}
 .table{overflow:auto;-webkit-overflow-scrolling:touch}.table table{min-width:720px}
 .miniRadio{left:94px;right:12px;bottom:12px;grid-template-columns:minmax(190px,1fr) auto minmax(120px,220px) auto;gap:10px}
 .radioGrid{grid-template-columns:1fr 1fr}.radioConsole{grid-template-columns:1fr auto}.volumeControl{grid-column:1/-1}
}

/* Phone */
@media(max-width:760px){
 .pubnav{padding:8px 16px}.logoFrame img{width:168px}.pubnav nav button{font-size:11px;padding:11px 14px}
 .hero{padding:42px 20px 52px}.hero::before{display:none}.heroLogoFrame{margin:14px 0 8px;width:100%}.heroCopy h1{font-size:clamp(40px,12vw,52px);line-height:1}.heroCopy>p{font-size:16px;line-height:1.6}.heroCard{display:none}.actions{gap:10px;margin:28px 0}.actions a{justify-content:center;min-height:46px}.trust{margin-top:22px}
 .benefits{grid-template-columns:1fr 1fr;padding:12px 14px}.benefits div{font-size:10px;padding:10px 8px;min-height:50px}
 .section{padding:62px 20px}.section h2{font-size:34px}.cards{grid-template-columns:1fr}.service{min-height:auto;padding:24px}.process{padding:34px 23px}.contact{padding:34px 24px}.contact>a{width:100%;text-align:center}.contactInfo{grid-template-columns:1fr;gap:16px}
 .workspace>header{padding:0 14px}.content{padding:18px 12px}.metrics{grid-template-columns:1fr}.dashgrid,.detailgrid,.machinegrid{grid-template-columns:1fr}.panel.wide,.panel.full{grid-column:auto}.toolbar{flex-wrap:wrap}.toolbar label{width:100%;flex-basis:100%}.toolbar>button{width:100%}.jobhead{align-items:flex-start;flex-direction:column;gap:12px}.jobhead>div:last-child{width:100%;display:grid;grid-template-columns:1fr 1fr;gap:8px}.jobhead>div:last-child select{grid-column:1/-1}.jobhead>div:last-child .primaryBtn{grid-column:1/-1}.table table{min-width:680px}
 .radioGrid{grid-template-columns:1fr}.radioConsole{grid-template-columns:1fr auto;padding:16px}.radioIntro{align-items:flex-start}.miniRadio{left:78px;right:8px;bottom:8px}
}

/* Small phone */
@media(max-width:430px){
 .pubnav{min-height:76px}.logoFrame img{width:145px}.pubnav nav button{padding:10px 12px}.hero{padding-left:16px;padding-right:16px}.heroCopy h1{font-size:39px}.benefits{grid-template-columns:1fr}.benefits div{border-right:0;border-bottom:1px solid rgba(255,255,255,.08)}
 .admin{grid-template-columns:64px 1fr}.admin aside{width:64px;padding-left:6px;padding-right:6px}.workspace{grid-column:2}.miniRadio{left:70px}.miniOpen{display:none}.miniRadio{grid-template-columns:1fr auto}.stationLogo.mini{width:38px;height:38px}.miniStation small{display:none}
}

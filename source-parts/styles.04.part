px;letter-spacing:.13em;color:#9eb09f}.miniStation b{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.stationLogo.mini{width:45px;height:45px;border-radius:12px;flex:0 0 auto}.miniPlay{width:44px;height:44px;border:0;border-radius:50%;background:var(--green);color:#152419;font-weight:900;display:grid;place-items:center;box-shadow:0 8px 22px rgba(134,184,74,.2)}.miniVolume{display:grid;grid-template-columns:20px 1fr;gap:8px;align-items:center}.miniVolume span{font-size:12px}.miniVolume input{width:100%;accent-color:var(--green)}.miniOpen{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.07);color:#fff;border-radius:10px;padding:9px 12px;font-size:9px;font-weight:750}.miniOpen span{margin-left:5px;color:#a9d57d}
@media(max-width:760px){.workspace .content{padding-bottom:135px}.miniRadio{left:80px;right:10px;bottom:10px;grid-template-columns:1fr auto auto;gap:8px;min-height:62px;padding:8px}.miniVolume{display:none}.miniOpen{padding:8px}.miniStation b{font-size:10px}.stationLogo.mini{width:40px;height:40px}.miniPlay{width:40px;height:40px}}

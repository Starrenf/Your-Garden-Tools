var(--line);display:flex;align-items:center;padding:20px 6vw;gap:28px;font-size:11px;color:#879188}.footerBrand{display:flex;align-items:center;justify-content:center;border:0;border-radius:0;padding:0;background:transparent}.footerBrand img{width:230px;height:auto;display:block;object-fit:contain}footer span{margin-right:auto}footer button{border:0;background:none;color:#758078}
/* admin */.admin{min-height:100vh;display:grid;grid-template-columns:240px 1fr}.admin aside{position:fixed;width:240px;inset:0 auto 0 0;background:var(--dark);padding:23px 14px;color:#fff;display:flex;flex-direction:column}.brandBox{border-bottom:1px solid rgba(255,255,255,.08);padding:0 9px 20px;text-align:center}.brandBox img{background:#fff;border-radius:12px;padding:8px;width:100%;height:86px;object-fit:contain;box-shadow:0 8px 22px rgba(0,0,0,.12)}.brandBox small{display:block;margin-top:8px;color:#829386;font-size:8px;letter-spacing:.2em}.admin aside nav{display:flex;flex-direction:column;gap:4px;margin-top:20px}.admin aside nav button,.siteBack{border:0;background:none;color:#a9b5ab;border-radius:9px;padding:11px 12px;display:flex;align-items:center;gap:11px;font-size:12px;text-align:left}.admin aside nav button:hover,.admin aside nav button.active{background:rgba(255,255,255,.075);color:#fff}.admin aside nav button em{margin-left:auto;font-style:normal;background:rgba(255,255,255,.08);padding:3px 7px;border-radius:99px;font-size:9px}.profile{margin-top:auto;border-top:1px solid rgba(255,255,255,.08);padding:16px 9px 10px;display:flex;gap:10px;align-items:center}.profile>b,.avatar{width:34px;height:34px;border-radius:9px;background:var(--green);color:#1c2b1f;display:grid;place-items:center;font-size:10px}.profile span{display:flex;flex-direction:column;font-size:10px}.profile small{color:#829086}.siteBack{font-size:10px}.workspace{grid-column:2}.workspace>header{height:88px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 36px}.workspace>header small{font-size:9px;color:#96a098;text-transform:uppercase}.workspace>header h1{font-size:23px;margin:3px 0 0}.content{padding:29px 36px 55px;max-width:1500px;margin:auto}.topline,.toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.topline p{font-size:12px;color:#7c877e}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:16px}.metric{background:#fff;border:1px solid var(--line);border-radius:13px;padding:17px;display:flex;gap:13px;align-items:center}.metric>i{width:42px;height:42px;border-radius:10px;background:#edf3e8;color:#678847;display:grid;place-items:center;font-style:normal}.metric span{display:flex;flex-direction:column}.metric small{font-size:9px;color:#839087}.metric b{font-size:24px;line-height:1.2}.metric em{font-style:normal;font-size:8px;color:#9aa39c}.dashgrid,.detailgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.panel{background:#fff;border:1px solid var(--line);border-radius:13px;padding:19px}.panel.wide{grid-column:span 2}.panel.full{grid-column:1/-1}.panel.note{background:linear-gradient(110deg,#f2f6ee,#fff)}.panel.note p{font-size:11px;color:#748077;line-height:1.6;margin:0}.panelHead{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.panelHead h3{font-size:13px;margin:0}.panelHead button{border:0;background:none;color:#71816d;font-size:9px}.jobrow{width:100%;display:grid;grid-template-columns:36px 1fr auto 86px 15px;gap:9px;align-items:center;border:0;border-top:1px solid #edf0ec;background:none;padding:11px 3px;text-align:left}.jobrow:hover{background:#fafbf9}.jobrow>i{width:34px;height:34px;background:#eff4ec;border-radius:8px;display:grid;place-items:center;color:#61765a;font-style:normal}.jobrow>span{display:flex;flex-direction:column}.jobrow b{font-size:11px}.jobrow small{font-size:9px;color:#909a92}.badge{font-size:8px;font-style:normal;font-weight:750;border-radius:999px;padding:5px 8px}.badge.purple{background:#f0e9fb;color:#7557a3}.badge.amber{background:#fff1d5;color:#9b6e20}.badge.green{background:#e7f5e9;color:#4f8657}.badge.blue{background:#e8f1fa;color:#48759a}.quick{display:grid;grid-template-columns:1fr 1fr;gap:8px}.quick button{border:1px solid var(--line);background:#fbfcfa;border-radius:9px;padding:14px 7px;display:flex;flex-direction:column;align-items:center;gap:5px}.quick span{font-size:9px;color:#69756b}.today{display:flex;flex-direction:column}.today span{display:grid;grid-template-columns:14px 25px 1fr;border-top:1px solid #edf0ed;padding:11px 0;font-size:9px;color:#748077}.today i{width:7px;height:7px;border-radius:50%;margin-top:3px}.today .purple{background:#9e7bc8}.today .amber{background:#e0ad43}.today .green{background:#68a76f}.toolbar label{height:39px;width:400px;background:#fff;border:1px solid var(--line);border-radius:9px;display:flex;align-items:center;padding:0 11px;color:#8e9990}.toolbar input{border:0;outline:0;background:none;width:100%;padding-left:8px;font-size:10px}.table{background:#fff;border:1px solid var(--line);border-radius:13px;overflow:hidden}.table table{width:100%;border-collapse:collapse}.table th{text-align:left;padding:11px 14px;background:#fafbf9;font-size:8px;letter-spacing:.08em;text-transform:uppercase;color:#929c94}.table td{padding:12px 14px;border-top:1px solid #edf0ec;font-size:10px}.table td>b,.table td>small{display:block}.table td small{color:#929b94;margin-top:3px}.person{display:flex;align-items:center;gap:9px}.person>i{width:31px;height:31px;background:#edf3e9;border-radius:8px;display:grid;place-items:center;color:#607b4e;font-size:8px;font-style:normal;font-weight:800}.person span{display:flex;flex-direction:column}.click{cursor:pointer}.click:hover{background:#fbfcfa}.machinegrid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.machine{background:#fff;border:1px solid var(--line);border-radius:13px;overflow:hidden}.machinePic{height:142px;background:linear-gradient(145deg,#edf3e8,#f8faf7);display:grid;place-items:center;font-size:56px;color:#52674d;position:relative}.machinePic span{position:absolute;bottom:9px;left:10px;background:#fff;border:1px solid var(--line);border-radius:99px;padding:4px 7px;font-size:8px}.machine>div:last-child{padding:16px}.machine>div>small{font-size:8px;letter-spacing:.1em;color:#759061;text-transform:uppercase}.machine h3{margin:3px 0 13px}.machine p{display:flex;justify-content:space-between;border-top:1px solid #edf0ed;padding-top:7px;font-size:9px;color:#707c73}.machine p b{color:#9ba49d;font-weight:500}.back{border:0;background:none;color:#708076;font-size:10px;padding:0;margin-bottom:16px}.jobhead{display:flex;justify-content:space-between;align-items:end;margin-bottom:20px}.jobhead h2{font-size:28px;margin:5px 0 2px}.jobhead 
rvice small{color:#a3aca4}.service h3{margin:32px 0 12px}.service p{font-size:13px;color:#748077;line-height:1.7}.service a{margin-top:auto;font-size:12px;font-weight:700}.process{background:var(--dark);color:#fff;border-radius:26px;padding:65px;display:grid;grid-template-columns:.85fr 1.15fr;gap:75px}.process h2{margin-top:12px}.process>div:first-child p{color:#aeb9b1;line-height:1.7}.steps{display:grid;grid-template-columns:1fr 1fr;gap:22px}.step{display:flex;gap:15px;padding-bottom:18px;border-bottom:1px solid rgba(255,255,255,.1)}.step>span{color:#9dcc67;font-size:10px}.step b{font-size:14px}.step p{font-size:11px;line-height:1.5;color:#9eaaa1}.contact{background:linear-gradient(120deg,#6e9d38,#8abd4d);color:#fff;border-radius:24px;padding:55px 60px;display:flex;justify-content:space-between;align-items:end}.contact h2{margin-bottom:0}.contact h2 em{color:#efffda}.contact>a{background:#fff;color:#182319;padding:14px 20px;border-radius:11px;font-weight:800}.contactInfo{display:grid;grid-template-columns:2fr 1fr 1.4fr;padding:28px 10px 0}.contactInfo span{display:flex;flex-direction:column;font-size:12px}.contactInfo small{font-size:9px;letter-spacing:.1em;color:#95a097;text-transform:uppercase;margin-bottom:4px}footer{min-height:116px;background:#fff;border-top:1px solid var(--line);display:flex;align-items:center;padding:20px 6vw;gap:28px;font-size:11px;color:#879188}.footerBrand{display:flex;align-items:center;justify-content:center;border:1px solid #edf1eb;border-radius:16px;padding:8px 12px;background:#fff}.footerBrand img{height:64px;display:block;object-fit:contain}footer span{margin-right:auto}footer button{border:0;background:none;color:#758078}
/* admin */.admin{min-height:100vh;display:grid;grid-template-columns:240px 1fr}.admin aside{position:fixed;width:240px;inset:0 auto 0 0;background:var(--dark);padding:23px 14px;color:#fff;display:flex;flex-direction:column}.brandBox{border-bottom:1px solid rgba(255,255,255,.08);padding:0 9px 20px;text-align:center}.brandBox img{background:#fff;border-radius:12px;padding:8px;width:100%;height:86px;object-fit:contain;box-shadow:0 8px 22px rgba(0,0,0,.12)}.brandBox small{display:block;margin-top:8px;color:#829386;font-size:8px;letter-spacing:.2em}.admin aside nav{display:flex;flex-direction:column;gap:4px;margin-top:20px}.admin aside nav button,.siteBack{border:0;background:none;color:#a9b5ab;border-radius:9px;padding:11px 12px;display:flex;align-items:center;gap:11px;font-size:12px;text-align:left}.admin aside nav button:hover,.admin aside nav button.active{background:rgba(255,255,255,.075);color:#fff}.admin aside nav button em{margin-left:auto;font-style:normal;background:rgba(255,255,255,.08);padding:3px 7px;border-radius:99px;font-size:9px}.profile{margin-top:auto;border-top:1px solid rgba(255,255,255,.08);padding:16px 9px 10px;display:flex;gap:10px;align-items:center}.profile>b,.avatar{width:34px;height:34px;border-radius:9px;background:var(--green);color:#1c2b1f;display:grid;place-items:center;font-size:10px}.profile span{display:flex;flex-direction:column;font-size:10px}.profile small{color:#829086}.siteBack{font-size:10px}.workspace{grid-column:2}.workspace>header{height:88px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 36px}.workspace>header small{font-size:9px;color:#96a098;text-transform:uppercase}.workspace>header h1{font-size:23px;margin:3px 0 0}.content{padding:29px 36px 55px;max-width:1500px;margin:auto}.topline,.toolbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.topline p{font-size:12px;color:#7c877e}.metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:13px;margin-bottom:16px}.metric{background:#fff;border:1px solid var(--line);border-radius:13px;padding:17px;display:flex;gap:13px;align-items:center}.metric>i{width:42px;height:42px;border-radius:10px;background:#edf3e8;color:#678847;display:grid;place-items:center;font-style:normal}.metric span{display:flex;flex-direction:column}.metric small{font-size:9px;color:#839087}.metric b{font-size:24px;line-height:1.2}.metric em{font-style:normal;font-size:8px;color:#9aa39c}.dashgrid,.detailgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.panel{background:#fff;border:1px solid var(--line);border-radius:13px;padding:19px}.panel.wide{grid-column:span 2}.panel.full{grid-column:1/-1}.panel.note{background:linear-gradient(110deg,#f2f6ee,#fff)}.panel.note p{font-size:11px;color:#748077;line-height:1.6;margin:0}.panelHead{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}.panelHead h3{font-size:13px;margin:0}.panelHead button{border:0;background:none;color:#71816d;font-size:9px}.jobrow{width:100%;display:grid;grid-template-columns:36px 1fr auto 86px 15px;gap:9px;align-items:center;border:0;border-top:1px solid #edf0ec;background:none;padding:11px 3px;text-align:left}.jobrow:hover{background:#fafbf9}.jobrow>i{width:34px;height:34px;background:#eff4ec;border-radius:8px;display:grid;place-items:center;color:#61765a;font-style:normal}.jobrow>span{display:flex;flex-direction:column}.jobrow b{font-size:11px}.jobrow small{font-size:9px;color:#909a92}.badge{font-size:8px;font-style:normal;font-weight:750;border-radius:999px;padding:5px 8px}.badge.purple{background:#f0e9fb;color:#7557a3}.badge.amber{background:#fff1d5;color:#9b6e20}.badge.green{background:#e7f5e9;color:#4f8657}.badge.blue{background:#e8f1fa;color:#48759a}.quick{display
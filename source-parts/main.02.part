data} setData={setData} id={selected} back={()=>setPage('jobs')}/>} {page==='invoices'&&<Invoices data={data}/>} {page==='radio'&&<Radio selected={radioStation} playing={radioPlaying} volume={radioVolume} error={radioError} choose={chooseStation} toggle={toggleRadio} setVolume={setRadioVolume}/>}</div></section><audio ref={audio} preload="none" onEnded={()=>setRadioPlaying(false)} onError={()=>{setRadioPlaying(false);setRadioError('De stream is tijdelijk niet bereikbaar. Kies eventueel een andere zender.')}}/><MiniRadio station={currentStation} playing={radioPlaying} volume={radioVolume} toggle={toggleRadio} setVolume={setRadioVolume} openRadio={()=>setPage('radio')}/>{modal==='customer'&&<CustomerModal data={data} setData={setData} close={()=>setModal(null)}/>} {modal==='job'&&<JobModal data={data} setData={setData} close={()=>setModal(null)}/>}</div>
}
const Nav=({p,page,set,i,t,n})=><button className={page===p||(p==='jobs'&&page==='job')?'active':''} onClick={()=>set(p)}><I n={i}/><span>{t}</span>{n!=null&&<em>{n}</em>}</button>;
function Dashboard({data,setPage,open,add}){const openCount=data.jobs.filter(j=>!['Gereed','Afgehaald'].includes(j.status)).length;return <><div className="topline"><p>Hier zie je wat er vandaag in de werkplaats speelt.</p><button className="primaryBtn" onClick={add}><I n="plus"/>Nieuwe opdracht</button></div><div className="metrics"><Metric t="Open opdrachten" v={openCount} s="2 nieuw deze week"/><Metric t="Gereed voor afhalen" v={data.jobs.filter(j=>j.status==='Gereed').length} s="Klaar voor klant"/><Metric t="Klanten" v={data.customers.length} s="In klantenbestand"/><Metric t="Facturen" v={data.invoices.length} s="Administratie"/></div><div className="dashgrid"><Panel title="Lopende opdrachten" cls="wide" action={()=>setPage('jobs')}>{data.jobs.map(j=><JobRow key={j.id} j={j} data={data} open={()=>open(j)}/>)}</Panel><Panel title="Snel toevoegen"><div className="quick"><button onClick={()=>setPage('customers')}>◎<span>Klant</span></button><button onClick={add}>▣<span>Opdracht</span></button><button onClick={()=>setPage('machines')}>◉<span>Machine</span></button><button onClick={()=>setPage('invoices')}>▤<span>Factuur</span></button></div></Panel><Panel title="Werkplaats vandaag"><div className="today"><span><i className="purple"></i><b>2</b>In uitvoering</span><span><i className="amber"></i><b>1</b>Wacht op akkoord</span><span><i className="green"></i><b>0</b>Gereed</span></div></Panel><Panel title="Onderhoudshistorie centraal" cls="wide note"><p>Alle werkzaamheden blijven gekoppeld aan klant én machine. Zo zie je bij een volgend bezoek meteen wat eerder is uitgevoerd.</p></Panel></div></>}
const Metric=({t,v,s})=><div className="metric"><i>⌁</i><span><small>{t}</small><b>{v}</b><em>{s}</em></span></div>;
const Panel=({title,children,cls='',action})=><section className={'panel '+cls}><div className="panelHead"><h3>{title}</h3>{action&&<button onClick={action}>Alles bekijken →</button>}</div>{children}</section>;
const JobRow=({j,data,open})=>{const c=data.customers.find(x=>x.id===j.customerId),m=data.machines.find(x=>x.id===j.machineId);return <button className="jobrow" onClick={open}><i>◉</i><span><b>{m?.brand} {m?.model}</b><small>{c?.name} · {j.number}</small></span><em className={'badge '+badge(j.status)}>{j.status}</em><small>{fmt(j.due)}</small><strong>›</strong></button>};
function Toolbar({q,setQ,ph,add,label}){return <div className="toolbar"><label><I n="search"/><input value={q||''} onChange={e=>setQ?.(e.target.value)} placeholder={ph}/></label>{add&&<button className="primaryBtn" onClick={add}><I n="plus"/>{label}</button>}</div>}
function Customers({data,add}){const[q,setQ]=useState('');const rows=data.customers.filter(c=>(c.name+c.email+c.city).toLowerCase().includes(q.toLowerCase()));return <><Toolbar q={q} setQ={setQ} ph="Zoek op naam, e-mail of plaats..." add={add} label="Nieuwe klant"/><Table head={['Klant','Contact','Plaats','Machines','']}>{rows.map(c=><tr key={c.id}><td><div className="person"><i>{c.name.split(' ').map(x=>x[0]).slice(0,2).join('')}</i><span><b>{c.name}</b><small>Klant sinds 2026</small></span></div></td><td><b>{c.phone}</b><small>{c.email}</small></td><td>{c.city}</td><td>{data.machines.filter(m=>m.customerId===c.id).length}</td><td>•••</td></tr>)}</Table></>}
function Machines({data}){return <><Toolbar ph="Zoek op merk, type of serienummer..."/><div className="machinegrid">{data.machines.map(m=>{const c=data.customers.find(x=>x.id===m.customerId);return <article className="machine" key={m.id}><div className="machinePic">◉<span>{m.type}</span></div><div><small>{m.brand}</small><h3>{m.model}</h3><p><b>Eigenaar</b>{c?.name}</p><p><b>Serienummer</b>{m.serial}</p><p><b>Motor</b>{m.engine}</p></div></article>})}</div></>}
function Jobs({data,open,add}){const[q,setQ]=useState('');const rows=data.jobs.filter(j=>{const c=data.customers.find(x=>x.id===j.customerId),m=data.machines.find(x=>x.id===j.machineId);return (j.number+j.title+c?.name+m?.brand+m?.model).toLowerCase().includes(q.toLowerCase())});return <><Toolbar q={q} setQ={setQ} ph="Zoek opdrachten..." add={add} label="Nieuwe opdracht"/><Table head={['Opdracht','Klant & machine','Status','Aangemaakt','Gepland','']}>{rows.map(j=>{const c=data.customers.find(x=>x.id===j.customerId),m=data.machines.find(x=>x.id===j.machineId);return <tr key={j.id} onClick={()=>open(j)} className="click"><td><b>{j.number}</b><small>{j.title}</small></td><td><b>{c?.name}</b><small>{m?.brand} {m?.model}
th:100%;accent-color:var(--green)}.volumeControl b{text-align:right;color:#fff}.radioError{margin-top:12px;background:#fff0ef;border:1px solid #f2d0cd;color:#a65049;border-radius:11px;padding:11px 13px;font-size:10px}.radioNote{margin-top:14px;background:#fff;border:1px solid var(--line);border-radius:13px;padding:14px 16px;display:flex;gap:10px;align-items:center;font-size:10px}.radioNote b{color:#5f7f43}.radioNote span{color:#7d8980}
@media(max-width:1050px){.radioGrid{grid-template-columns:repeat(2,1fr)}.radioConsole{grid-template-columns:1fr auto}.volumeControl{grid-column:1/-1}}
@media(max-width:760px){.radioIntro{align-items:flex-start;flex-direction:column;gap:12px}.radioGrid{grid-template-columns:1fr}.radioConsole{grid-template-columns:1fr auto;padding:17px}.volumeControl{grid-column:1/-1}.radioNote{align-items:flex-start;flex-direction:column}}
/* persistent werkplaatsradio */
.workspace .content{padding-bottom:120px}
.miniRadio{position:fixed;left:260px;right:22px;bottom:18px;z-index:40;min-height:68px;background:rgba(23,37,28,.97);backdrop-filter:blur(14px);color:#fff;border:1px solid rgba(255,255,255,.1);border-radius:18px;box-shadow:0 22px 60px rgba(12,28,17,.28);display:grid;grid-template-columns:minmax(220px,1fr) auto minmax(180px,300px) auto;align-items:center;gap:16px;padding:9px 12px 9px 10px}.miniRadio.isPlaying{box-shadow:0 22px 70px rgba(65,103,46,.34)}.miniStation{border:0;background:none;color:#fff;display:flex;align-items:center;gap:11px;text-align:left;min-width:0}.miniStation>span:last-child{display:flex;flex-direction:column;min-width:0}.miniStation small{font-size:7px;letter-spacing:.13em;color:#9eb09f}.miniStation b{font-size:12px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.stationLogo.mini{width:45px;height:45px;border-radius:12px;flex:0 0 auto}.miniPlay{width:44px;height:44px;border:0;border-radius:50%;background:var(--green);color:#152419;font-weight:900;display:grid;place-items:center;box-shadow:0 8px 22px rgba(134,184,74,.2)}.miniVolume{display:grid;grid-template-columns:20px 1fr;gap:8px;align-items:center}.miniVolume span{font-size:12px}.miniVolume input{width:100%;accent-color:var(--green)}.miniOpen{border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.07);color:#fff;border-radius:10px;padding:9px 12px;font-size:9px;font-weight:750}.miniOpen span{margin-left:5px;color:#a9d57d}
@media(max-width:760px){.workspace .content{padding-bottom:135px}.miniRadio{left:80px;right:10px;bottom:10px;grid-template-columns:1fr auto auto;gap:8px;min-height:62px;padding:8px}.miniVolume{display:none}.miniOpen{padding:8px}.miniStation b{font-size:10px}.stationLogo.mini{width:40px;height:40px}.miniPlay{width:40px;height:40px}}

/* v7 — responsive polish & extra visual energy */
:root{--green2:#a7d86b;--lime:#c9f28e;--glass:rgba(255,255,255,.72);--shadow-soft:0 16px 45px rgba(20,42,28,.09);--shadow-strong:0 28px 80px rgba(20,42,28,.17)}
body{overflow-x:hidden;background:linear-gradient(180deg,#f7f9f5 0%,#f3f6f1 100%)}
button:focus-visible,a:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible{outline:3px solid rgba(134,184,74,.35);outline-offset:3px}
.pubnav{background:rgba(255,255,255,.88);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:0 8px 28px rgba(24,47,30,.045)}
.pubnav nav a{position:relative}.pubnav nav a::after{content:"";position:absolute;left:0;right:100%;bottom:-7px;height:2px;border-radius:2px;background:linear-gradient(90deg,var(--green),var(--green2));transition:.25s ease}.pubnav nav a:hover::after{right:0}
.pubnav nav button,.actions .primary,.primaryBtn,.contact>a{transition:transform .2s ease,box-shadow .2s ease,filter .2s ease}.pubnav nav button:hover,.actions .primary:hover,.primaryBtn:hover,.contact>a:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(64,105,47,.22);filter:saturate(1.08)}
.hero{position:relative;isolation:isolate;background:radial-gradient(circle at 78% 22%,rgba(169,218,110,.25),transparent 26%),radial-gradient(circle at 18% 10%,rgba(255,255,255,.95),transparent 30%),linear-gradient(135deg,#f8fbf5 0,#edf5e7 62%,#e6f0dd 100%)}
.hero::before{content:"";position:absolute;z-index:-1;width:430px;height:430px;right:-110px;top:80px;border-radius:50%;border:1px solid rgba(104,145,72,.13);box-shadow:0 0 0 55px rgba(128,177,83,.03),0 0 0 115px rgba(128,177,83,.025)}
.hero::after{content:"";position:absolute;z-index:-1;width:180px;height:180px;left:44%;bottom:-90px;border-radius:50%;background:radial-gradient(circle,rgba(143,198,86,.18),transparent 68%);filter:blur(4px)}
.heroCopy{animation:fadeUp .65s ease both}.heroCard{animation:heroFloat 5s ease-in-out infinite;box-shadow:var(--shadow-strong);border:1px solid rgba(255,255,255,.85)}
.heroLogo{transition:transform .28s ease,filter .28s ease}.heroLogoFrame:hover .heroLogo{transform:scale(1.018);filter:drop-shadow(0 16px 24px rgba(20,42,28,.13))}
.heroCopy h1 em{background:linear-gradient(100deg,#75a83c,#9acb5f);-webkit-background-clip:text;background-clip:text;color:transparent}
.actions .secondary{box-shadow:0 10px 26px rgba(20,42,28,.05)}.actions .secondary:hover{transform:translateY(-2px);box-shadow:0 14px 32px rgba(20,42,28,.09)}
.trust>span{box-shadow:inset 0 0 0 1px rgba(91,126,61,.08),0 7px 18px rgba(77,120,54,.09)}
.brandShowcase{background:radial-gradient(circle at 85% 85%,rgba(166,215,105,.31),transparent 31%),linear-gradient(145deg,#eef6e9,#fbfdf9)}
.brandInfo div{backdrop-filter:blur(12px);box-shadow:0 8px 22px rgba(24,48,30,.045);transition:.22s ease}.brandInfo div:hover{transform:translateX(4px);border-color:#cee0bf}
.float{animation:floatBadge 4s ease-in-out infinite}
.benefits{background:linear-gradient(105deg,#132219,#1d3324 55%,#173021)}.benefits div{transition:.2s ease}.benefits div:hover{color:#fff;transform:translateY(-2px)}
.service,.metric,.panel,.stationCard,.table{box-shadow:0 10px 28px rgba(22,43,27,.035)}
.service{position:relative;overflow:hidden;transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}.service::after{content:"";position:absolute;inset:auto -45px -55px auto;width:125px;height:125px;border-radius:50%;background:radial-gradient(circle,rgba(145,199,86,.16),transparent 68%);transition:.3s ease}.service:hover{transform:translateY(-8px);box-shadow:0 24px 55px rgba(24,49,29,.12);border-color:#cfdfc5}.service:hover::after{transform:scale(1.35)}
.process{position:relative;overflow:hidden;background:radial-gradient(circle at 85% 20%,rgba(139,193,85,.16),transparent 26%),linear-gradient(130deg,#15241b,#20392a)}.process::after{content:"";position:absolute;width:250px;height:250px;border:1px solid rgba(255,255,255,.06);border-radius:50%;right:-70px;bottom:-90px;box-shadow:0 0 0 50px rgba(255,255,255,.018)}
.step{transition:.2s ease}.step:hover{tran
benefits div{padding:12px}.section{padding:70px 20px}.sectionHead{grid-template-columns:1fr;gap:10px}.cards{grid-template-columns:1fr}.process{padding:35px 24px}.steps{grid-template-columns:1fr}.contact{padding:38px 25px;flex-direction:column;align-items:flex-start;gap:25px}.contactInfo{grid-template-columns:1fr;gap:18px}footer{flex-wrap:wrap;gap:14px;padding:20px}.footerBrand img{height:52px}.admin{grid-template-columns:68px 1fr}.admin aside{width:68px;padding:17px 7px}.brandBox img{height:38px;padding:4px}.brandBox small,.admin aside nav button span,.admin aside nav button em,.profile span,.siteBack{display:none}.admin aside nav button{justify-content:center}.workspace{grid-column:2}.workspace>header{padding:0 17px}.content{padding:20px 16px}.metrics{grid-template-columns:1fr}.dashgrid,.detailgrid{grid-template-columns:1fr}.panel.wide,.panel.full{grid-column:auto}.machinegrid{grid-template-columns:1fr}.table{overflow:auto}.table table{min-width:680px}.jobhead{align-items:flex-start;flex-direction:column;gap:12px}.jobhead>div:last-child{flex-wrap:wrap}.toolbar label{width:65%}.section h2{font-size:36px}}
/* werkplaatsradio */
.radioPage{max-width:1120px}.radioIntro{display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:22px}.radioIntro h2{font-size:30px;letter-spacing:-.035em;margin:7px 0 5px}.radioIntro p{margin:0;color:#7d8980;font-size:12px}.radioLive{display:flex;align-items:center;gap:8px;background:#fff;border:1px solid var(--line);border-radius:999px;padding:9px 13px;font-size:10px;color:#68756b}.pulse{width:8px;height:8px;border-radius:50%;background:#aab3ac}.pulse.on{background:#68a76f;box-shadow:0 0 0 6px rgba(104,167,111,.12)}.radioGrid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-bottom:18px}.stationCard{border:1px solid var(--line);background:#fff;border-radius:15px;padding:15px;display:grid;grid-template-columns:48px 1fr 18px;gap:11px;align-items:center;text-align:left;box-shadow:0 8px 24px rgba(26,45,31,.035)}.stationCard:hover{transform:translateY(-2px);box-shadow:0 14px 34px rgba(26,45,31,.08)}.stationCard.selected{border-color:#9dc477;background:linear-gradient(135deg,#fbfdf9,#f0f6ea);box-shadow:0 12px 30px rgba(92,139,51,.11)}.stationLogo{width:48px;height:48px;border-radius:13px;display:grid;place-items:center;background:#edf2e9;color:#344332;font-weight:900;font-size:14px;letter-spacing:-.04em}.stationLogo.npo1{background:#e9f0fb;color:#305990}.stationLogo.npo2{background:#f2e9fb;color:#7653a0}.stationLogo.\33 fm{background:#e6f4ed;color:#267452}.stationLogo.qmusic{background:#ffe8ec;color:#d82a4a}.stationLogo.\35 38{background:#e9f2ff;color:#2266ad}.stationLogo.sky{background:#e7f4ff;color:#2a83b7}.stationLogo.radio10{background:#fff0df;color:#bf6822}.stationLogo.veronica{background:#ececec;color:#2c2c2c}.stationMeta{display:flex;flex-direction:column;gap:3px;min-width:0}.stationMeta b{font-size:11px}.stationMeta small{font-size:8px;color:#8f9991}.stationCheck{font-size:15px;color:#77906b;text-align:right}.radioConsole{background:linear-gradient(115deg,#17251c,#22352a);color:#fff;border-radius:20px;padding:22px 24px;display:grid;grid-template-columns:1fr auto 280px;gap:24px;align-items:center;box-shadow:0 25px 55px rgba(18,38,24,.18)}.nowPlaying{display:flex;align-items:center;gap:15px}.stationLogo.big{width:62px;height:62px;border-radius:17px;font-size:18px}.nowPlaying small{font-size:7px;letter-spacing:.16em;color:#98aa9c}.nowPlaying h3{font-size:18px;margin:3px 0}.nowPlaying p{margin:0;font-size:9px;color:#9eaca1}.playButton{width:54px;height:54px;border-radius:50%;border:0;background:var(--green);color:#152419;font-size:16px;display:grid;place-items:center;box-shadow:0 10px 25px rgba(134,184,74,.22)}.volumeControl{display:grid;grid-template-columns:20px 1fr 34px;gap:9px;align-items:center;font-size:9px;color:#b7c1b9}.volumeControl input{width:100%;accent-color:var(--green)}.volumeControl b{text-align:right;color:#fff}.radioError{margin-top:12px;background:#fff0ef;border:1px solid #f2d0cd;color:#a65049;border-radius:11px;padding:11px 13px;font-size:10px}.radioNote{margin-top:14px;background:#fff;border:1px solid var(--line);border-radius:13px;padding:14px 16px;display:flex;gap:10px;align-items:center;font-size:10px}.radioNote b{color:#5f7f43}.radioNote span{color:#7d8980}
@media(max-width:1050px){.radioGrid{grid-template-columns:repeat(2,1fr)}.radioConsole{grid-template-columns:1fr auto}.volumeControl{grid-column:1/-1}}
@media(max-width:760px){.radioIntro{align-items:flex-start;flex-direction:column;gap:12px}.radioGrid{grid-template-columns:1fr}.radioConsole{grid-template-columns:1fr auto;padding:17px}.volumeControl{grid-column:1/-1}.radioNote{align-items:flex-start;flex-direction:column}}
/* persistent werkplaatsradio */
.workspace .content{padding-bottom:120px}
.miniRadio{position:fixed;left:260px;right:22px;bottom:18px;z-index:40;min-height:68px;background:rgba(23,37,28,.97);backdrop-filter:blur(14px);color:#fff;border:1px solid rgba(255,255,255,.1);border-radius:18px;box-shadow:0 22px 60px rgba(12,28,17,.28);display:grid;grid-template-columns:minmax(220px,1fr) auto minmax(180px,300px) auto;align-items:center;gap:16px;padding:9px 12px 9px 10px}.miniRadio.isPlaying{box-shadow:0 22px 70px rgba(65,103,46,.34)}.miniStation{border:0;background:none;color:#fff;display:flex;align-items:center;gap:11px;text-align:left;min-width:0}.miniStation>span:last-child{display:flex;flex-direction:column;min-width:0}.miniStation small{font-size:7
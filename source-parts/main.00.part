const STORE='ygt-vite-v3';

const RADIO_STATIONS=[
 {id:'npo1',name:'NPO Radio 1',tag:'Nieuws & actualiteit',short:'1',stream:'https://icecast.omroep.nl/radio1-bb-mp3'},
 {id:'npo2',name:'NPO Radio 2',tag:'Muziek & verhalen',short:'2',stream:'https://icecast.omroep.nl/radio2-bb-mp3'},

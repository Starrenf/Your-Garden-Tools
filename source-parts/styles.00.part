:root{font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#172219;background:#f5f7f3;--green:#86b84a;--dark:#17251c;--line:#e2e8df;--muted:#7c887e;--white:#fff;--shadow:0 25px 70px rgba(20,42,28,.12)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}button,input,select,textarea{font:inherit}button,a{transition:.2s}button{cursor:pointer}a{text-decoration:none;color:inherit}.ico{display:inline-flex;align-items:center;justify-content:center}.eyebrow{font-size:10px;letter-spacing:.18em;font-weight:800;color:#5b7e3d}.eyebrow.light{color:#b7df83}em{font-style:normal;color:var(--green)}
.pubnav{height:96px;background:#fff;display:flex;align-items:center;justify-content:space-between;padding:0 5vw;position:sticky;top:0;z-index:20;border-bottom:1px solid #edf1eb}.logoFrame{display:flex;align-items:center;justify-content:center;background:#fff;border:1px solid #edf1eb;border-radius:16px;padding:8px 12px;box-shadow:0 10px 28px rgba(22,37,28,.06)}.logoFrame img{height:64px;display:block;object-fit:contain}.pubnav nav{display:flex;gap:28px;align-items:center;font-size:13px;font-weight:650}.pubnav nav button{border:0;background:var(--dark);color:#fff;padding:11px 17px;border-radius:999px}.hero{min-height:720px;padding:75px 7vw;background:linear-gradient(130deg,#f8faf6 0,#edf3e8 75%,#e4eddc 100%);display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:7vw;overflow:hidden}.heroLogoFrame{display:inline-flex;align-items:center;justify-content:center;background:#fff;border:1px solid rgba(135,166,100,.18);border-radius:24px;padding:16px 18px;box-shadow:0 22px 60px rgba(20,42,28,.08);margin:18px 0 8px}.heroLogo{height:112px;display:block;object-fit:contain}.heroCopy h1{font-size:clamp(46px,5.2vw,74px);line-height:.98;letter-spacing:-.055em;margin:18px 0 28px}.heroCopy>p{font-size:18px;color:#657067;max-width:610px;line-height:1.7}.actions{display:flex;gap:12px;margin:34px 0}.actions a,.primaryBtn{border:0;border-radius:11px;padding:13px 17px;font-size:12px;font-weight:750;display:inline-flex;align-items:center;gap:8px}.actions .primary,.primaryBtn{background:var(--green);color:#172219;box-shadow:0 10px 26px rgba(93,145,46,.18)}.actions .secondary{background:#fff;border:1px solid var(--line)}.trust{display:flex;align-items:center;gap:10px;margin-top:28px}.trust>span{width:34px;height:34px;border-radius:50%;background:#dfead6;display:grid;place-items:center;color:#537b32;font-weight:800}.trust div{display:flex;flex-direction:column;font-size:12px}.trust small{color:#879187}.heroCard{background:#fff;border-radius:26px;padding:17px;box-shadow:var(--shadow);position:relative;transform:rotate(1.4deg)}.brandPreviewCard{padding:20px 20px 18px}.brandShowcase{min-height:370px;border-radius:22px;background:linear-gradient(145deg,#eef5ea,#f9fbf8);position:relative;overflow:hidden;display:flex;flex-direction:column;justify-content:center;padding:30px;gap:24px}.brandShowcase::before{content:"";position:absolute;inset:auto -50px -70px auto;width:220px;height:220px;background:radial-gradient(circle at center,#84b749 0,rgba(132,183,73,.25) 34%,rgba(132,183,73,0) 70%)}.brandShowcase::after{content:"";position:absolute;inset:24px 24px auto auto;width:120px;height:120px;border:1px dashed rgba(96,125,79,.22);border-radius:50%}.brandShowcase img{position:relative;z-index:1;width:100%;max-width:420px;object-fit:contain;filter:drop-shadow(0 10px 16px rgba(0,0,0,.06))}.brandInfo{position:relative;z-index:1;display:grid;grid-template-columns:1fr;gap:14px}.brandInfo div{background:rgba(255,255,255,.88);border:1px solid #e4eadf;border-radius:16px;padding:12px 14px}.brandInfo small{display:block;color:#7e8b80;font-size:9px;letter-spacing:.1em;text-transform:uppercase;margin-bottom:4px}.brandInfo b{font-size:13px;line-height:1.45}.heroCardBottom{padding:19px 9px 5px;display:flex;align-items:center;justify-content:space-between}.heroCardBottom span{display:flex;flex-direction:column}.heroCardBottom small{color:#8a948c;font-size:11px}.heroCardBottom b{font-size:16px}.heroCardBottom i{width:40px;height:40px;border-radius:50%;background:var(--dark);color:#fff;display:grid;place-items:center;font-style:normal}.float{position:absolute;left:-32px;bottom:90px;background:#fff;padding:14px 18px;border-radius:12px;box-shadow:var(--shadow);display:flex;flex-direction:column;font-size:11px;transform:rotate(-2deg)}.float small{color:#879187}.benefits{height:92px;background:var(--dark);color:#d9e1d9;display:grid;grid-template-columns:repeat(4,1fr);align-items:center;padding:0 7vw;font-size:12px}.benefits div{display:flex;align-items:center;gap:13px;border-right:1px solid rgba(255,255,255,.1);padding:0 20px}.benefits b{color:#98c762;font-size:10px}.section{max-width:1280px;margin:auto;padding:100px 34px}.sectionHead{display:grid;grid-template-columns:1fr 420px;gap:60px;align-items:end;margin-bottom:48px}.section h2{font-size:48px;letter-spacing:-.04em;line-height:1.05;margin:12px 0}.sectionHead p{color:#748077;line-height:1.7}.cards{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.service{background:#fff;border:1px solid var(--line);border-radius:17px;padding:27px;min-height:300px;display:flex;flex-direction:column}.service:hover{transform:translateY(-5px);box-shadow:var(--shadow)}.service>div{display:flex;justify-content:space-between}.service i{width:45px;height:45px;border-radius:11px;background:#eef4e9;display:grid;place-items:center;color:#628440;font-style:normal}.se
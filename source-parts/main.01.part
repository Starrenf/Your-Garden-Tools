me="benefits"><div><b>01</b>Persoonlijke service</div><div><b>02</b>Vakkundig onderhoud</div><div><b>03</b>Duidelijke afspraken</div><div><b>04</b>Betrouwbaar advies</div></section><section className="section" id="diensten"><div className="sectionHead"><div><span className="eyebrow">ONZE DIENSTEN</span><h2>Alles voor een machine<br/>die <em>blijft presteren.</em></h2></div><p>Van jaarlijkse onderhoudsbeurt tot het oplossen van een storing. Eerst kijken we wat uw machine écht nodig heeft.</p></div><div className="cards"><Service n="01" title="Onderhoud" text="Periodiek onderhoud voor betrouwbaar starten en een langere levensduur."/><Service n="02" title="Reparatie" text="Storingen en defecten deskundig onderzoeken en vakkundig herstellen."/><Service n="03" title="Slijpen & afstellen" text="Messen slijpen, balanceren en machines nauwkeurig afstellen."/><Service n="04" title="Advies & verkoop" text="Eerlijk advies over onderdelen, onderhoud en passende machines."/></div></section><section className="section" id="werkwijze"><div className="process"><div><span className="eyebrow light">ZO WERKEN WE</span><h2>Van brengen tot<br/><em>weer aan de slag.</em></h2><p>Geen ingewikkeld proces. Gewoon duidelijke afspraken en weten waar u aan toe bent.</p></div><div className="steps"><Step n="01" t="Machine brengen"/><Step n="02" t="Controle & advies"/><Step n="03" t="Onderhoud of reparatie"/><Step n="04" t="Klaar voor gebruik"/></div></div></section><section className="section" id="contact"><div className="contact"><div><span className="eyebrow light">KLAAR VOOR HET SEIZOEN?</span><h2>Geef uw tuingereedschap<br/>jaarlijks een <em>check-up.</em></h2></div><a href="tel:+31629575336">☎ 06 - 29 57 53 36</a></div><div className="contactInfo"><span><small>Werkplaats</small>Ingenopestraat 6, 6241 BZ Bunde</span><span><small>Telefoon</small>043 - 365 41 83</span><span><small>E-mail</small>info@yourgardentools.nl</span></div></section></main><footer><div className="footerBrand"><img src="/logo.png" alt="Your Garden Tools"/></div><span>© 2026 Your Garden Tools · Bunde</span><button onClick={enter}>Werkplaatsbeheer</button></footer></div>}
const Service=({n,title,text})=><article className="service"><div><i>⌁</i><small>{n}</small></div><h3>{title}</h3><p>{text}</p><a href="#contact">Meer informatie →</a></article>;
const Step=({n,t})=><div className="step"><span>{n}</span><div><b>{t}</b><p>We houden u op de hoogte en leggen afspraken duidelijk vast.</p></div></div>;

function Admin({data,setData,exit}){
 const[page,setPage]=useState('dashboard'),[selected,setSelected]=useState(null),[modal,setModal]=useState(null);
 const audio=useRef(null);
 const[radioStation,setRadioStation]=useState(()=>localStorage.getItem('ygt-radio-station')||'qmusic');
 const[radioPlaying,setRadioPlaying]=useState(false);
 const[radioVolume,setRadioVolume]=useState(()=>Number(localStorage.getItem('ygt-radio-volume')||.65));
 const[radioError,setRadioError]=useState('');
 const currentStation=RADIO_STATIONS.find(s=>s.id===radioStation)||RADIO_STATIONS[0];
 const open=j=>{setSelected(j.id);setPage('job')};
 useEffect(()=>{if(audio.current)audio.current.volume=radioVolume;localStorage.setItem('ygt-radio-volume',String(radioVolume))},[radioVolume]);
 const chooseStation=async id=>{setRadioStation(id);localStorage.setItem('ygt-radio-station',id);setRadioError('');const next=RADIO_STATIONS.find(s=>s.id===id);if(audio.current&&next){audio.current.src=next.stream;if(radioPlaying){try{await audio.current.play()}catch{setRadioPlaying(false);setRadioError('De stream kon niet automatisch starten. Druk nogmaals op afspelen.')}}}};
 const toggleRadio=async()=>{setRadioError('');if(!audio.current)return;if(radioPlaying){audio.current.pause();setRadioPlaying(false);return}try{if(audio.current.src!==currentStation.stream)audio.current.src=currentStation.stream;await audio.current.play();setRadioPlaying(true)}catch{setRadioPlaying(false);setRadioError('Deze stream kon niet worden afgespeeld. Probeer een andere zender.')}};
 return <div className="admin"><aside><div className="brandBox"><img src="/logo.png"/><small>WERKPLAATS</small></div><nav><Nav p="dashboard" page={page} set={setPage} i="home" t="Dashboard"/><Nav p="customers" page={page} set={setPage} i="users" t="Klanten" n={data.customers.length}/><Nav p="machines" page={page} set={setPage} i="machines" t="Machines" n={data.machines.length}/><Nav p="jobs" page={page} set={setPage} i="jobs" t="Opdrachten" n={data.jobs.length}/><Nav p="invoices" page={page} set={setPage} i="invoice" t="Facturen" n={data.invoices.length}/><Nav p="radio" page={page} set={setPage} i="radio" t="Werkplaatsradio"/></nav><div className="profile"><b>LN</b><span><strong>Ludo Neven</strong><small>Beheerder</small></span></div><button className="siteBack" onClick={exit}>← Naar website</button></aside><section className="workspace"><header><div><small>{fmt(new Date())}</small><h1>{({dashboard:'Goedemorgen, Ludo',customers:'Klanten',machines:'Machines',jobs:'Opdrachten',job:'Opdrachtdetails',invoices:'Facturen',radio:'Werkplaatsradio'})[page]}</h1></div><span className="avatar">LN</span></header><div className="content">{page==='dashboard'&&<Dashboard data={data} setPage={setPage} open={open} add={()=>setModal('job')}/>} {page==='customers'&&<Customers data={data} add={()=>setModal('customer')}/>} {page==='machines'&&<Machines data={data}/>} {page==='jobs'&&<Jobs data={data} open={open} add={()=>setModal('job')}/>} {page==='job'&&<Job data={